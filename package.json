{
  "name": "dnd-claude",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "play": "npm run build:web && npm run server",
    "server": "tsx packages/server/src/index.ts",
    "build:web": "npm run build --workspace @dnd/web",
    "dev:web": "npm run dev --workspace @dnd/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gallery": "tsx scripts/gallery.ts",
    "faces": "tsx scripts/faces-editor.ts",
    "gender": "tsx scripts/gender-editor.ts",
    "gender:apply": "tsx scripts/gender-apply.ts",
    "cards": "tsx scripts/cards-editor.ts",
    "cut": "tsx scripts/cut-editor.ts",
    "cut:apply": "tsx scripts/cut-apply.ts",
    "faces:apply": "tsx scripts/faces-apply.ts",
    "cards:apply": "tsx scripts/cards-apply.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
